{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "redirects": [
    {
      "source": "/engine/build/playcanvas.mjs",
      "destination": "https://cdn.jsdelivr.net/npm/playcanvas@2.23.0-beta.9/build/playcanvas.mjs",
      "permanent": false
    },
    {
      "source": "/engine/scripts/:path*",
      "destination": "https://cdn.jsdelivr.net/npm/playcanvas@2.23.0-beta.9/scripts/:path*",
      "permanent": false
    }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 120 }
  }
}
