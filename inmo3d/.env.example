# ---- Texto / visión (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
INMO3D_TEXT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (cuánto "piensa" el modelo: más = mejor y más caro)
INMO3D_EFFORT=medium

# ---- Imagen generativa (home staging virtual) ----
# gemini | openai | none
INMO3D_IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
INMO3D_GEMINI_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
INMO3D_OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Servidor ----
PORT=3113

# ---- Almacenamiento ----
# Local no hace falta nada: los archivos van a inmo3d/data/.
# En Vercel, creá un Blob Store (Storage -> Create -> Blob) y conectalo al proyecto:
# Vercel inyecta BLOB_READ_WRITE_TOKEN solo y la app pasa a usarlo automáticamente.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# INMO3D_DATA=/ruta/propia   (sólo para el servidor local)

# ---- Pipeline de reconstrucción ----
INMO3D_SFM=glomap          # glomap | colmap
INMO3D_TRAINER=brush       # brush | opensplat | nerfstudio
INMO3D_STEPS=15000
